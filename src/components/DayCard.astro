---
import type { CollectionEntry } from 'astro:content';
import WeatherChip from './WeatherChip.astro';
import ReservationBanner from './ReservationBanner.astro';
import PlaceCard from './PlaceCard.astro';
import LbbPanel from './LbbPanel.astro';
import MapPanel from './MapPanel.astro';
import RegionBar from './RegionBar.astro';
import TravelCallout from './TravelCallout.astro';
import Icon from './Icon.astro';
import DayStatus from './DayStatus.astro';
import { STAR } from '../lib/glyphs';

interface Props {
  day: CollectionEntry<'days'>['data'];
  categories: CollectionEntry<'categories'>[];
  places: CollectionEntry<'places'>['data'][];
  maps: CollectionEntry<'maps'>[];
  /** Every day's point, so each locator can draw the whole route behind it. */
  route: { lat: number; lng: number }[];
  peak: number;
  /** Sept 16 opens by default so the guide isn't a wall of closed rows. */
  open?: boolean;
  last?: boolean;
}
const { day, categories, places, maps, route, peak, open = false, last = false } = Astro.props;

const map = day.map ? maps.find((m) => m.id === day.map) : undefined;

// The design stars a day that has a booked table, as well as one the source
// marks with ★ directly.
const starred = day.pick || day.reservations.length > 0;

// Days split their suggestions into groups (Sept 22) or use one label.
type Pick = (typeof day.picks)[number];
const groups: { label: string | undefined; items: Pick[] }[] = [];
for (const pick of day.picks) {
  const label = pick.group ?? day.picksLabel;
  const last_ = groups.at(-1);
  if (last_ && last_.label === label) last_.items.push(pick);
  else groups.push({ label, items: [pick] });
}

/**
 * Where the day starts and where it ends, for the collapsed row.
 *
 * Scanning eleven shut days, "Cusco → Puno" is the thing you're looking for,
 * and it was only visible once you opened one. The middle stops stay inside.
 */
const named = day.journey.filter((stop) => !/^\(.*\)$/.test(stop));
const endpoints = named.length > 1 ? `${named[0]} → ${named.at(-1)}` : null;

// Little Black Book categories this day surfaces, resolved to their entries.
const lbb = day.lbb.flatMap((categoryId) => {
  const entry = categories.find((c) => c.id === categoryId);
  if (!entry) return [];
  return [{ category: entry.data, places: places.filter((p) => p.category === categoryId) }];
});
---

{day.regionStart && <RegionBar {...day.regionStart} />}

<details class:list={['day', { 'day--last': last }]} id={day.slug} open={open} data-day>
  <summary class="day__summary">
    <div class="day__date">
      <span class="day__num">{day.dayNumber}</span>
      <span class="day__month">{day.month}</span>
    </div>

    <div class="day__head">
      <div class="day__meta">
        <span class="day__weekday">
          {day.weekday}{day.tourDay && <> · {day.tourDay}</>}
        </span>
        <span class="day__chevron" aria-hidden="true">▼</span>
      </div>

      <h3 class="day__title">
        {day.title}
        {starred && <span class="day__star" aria-label="Highlight">{STAR}</span>}
      </h3>

      <p class="day__glance">{day.glance}</p>

      <div class="day__chips">
        <span class="day__chip day__chip--elev">
          <Icon name="mountain" size={13} />
          {day.elevation.label}
        </span>
        {
          endpoints && (
            <span class="day__chip day__chip--route">
              <Icon name="pin" size={13} />
              {endpoints}
            </span>
          )
        }
        {
          day.travelDay && (
            <span class="day__chip day__chip--travel">
              <Icon name="clock" size={13} />
              Travel day{day.travel && <> · {day.travel.duration}</>}
            </span>
          )
        }
        {day.overnight && <span class="day__chip">{day.overnight}</span>}
        <WeatherChip high={day.weather.high} low={day.weather.low} icon={day.weather.icon} />
      </div>
    </div>

    <DayStatus day={day} route={route} peak={peak} />
  </summary>

  <div class:list={['day__body', { 'day__body--lonelbb': lbb.length === 1 }]}>
    {/* Travel first. On a trip that is mostly getting somewhere, where today
        takes you frames everything under it — and a day can have a route with
        no transit to quote, so the block turns on for either. */}
    {(day.travel || day.journey.length > 0) && <TravelCallout {...day.travel} stops={day.journey} />}

    <p class="day__weathernote">{day.weather.note}</p>

    {
      day.logistics.length > 0 && (
        <div class="day__block">
          <p class="eyebrow">Logistics</p>
          <ul class="day__logistics">
            {day.logistics.map((item) => (
              <li class="day__logistic">{item}</li>
            ))}
          </ul>
        </div>
      )
    }

    {day.reservations.map((res) => <ReservationBanner {...res} showTimeInEyebrow={true} />)}

    {
      groups.map((group) => (
        <div class="day__block">
          {group.label && <p class="eyebrow">{group.label}</p>}
          <div class="day__picks">
            {group.items.map((pick) => (
              <PlaceCard {...pick} />
            ))}
          </div>
        </div>
      ))
    }

    {
      day.notes.map((note) => (
        <p class="day__note">
          <span class="day__note-label">Note</span>
          {note}
        </p>
      ))
    }

    {
      lbb.map(({ category, places: catPlaces }) => (
        <LbbPanel category={category} places={catPlaces} href={`#${category.slug}`} />
      ))
    }

    {map && <MapPanel view={map.data} id={`day-${day.slug}`} label={`${day.title} map`} />}
  </div>
</details>

<style>
  .day {
    border-top: 1px solid var(--rule-strong);
  }
  .day--last {
    border-bottom: 1px solid var(--rule-strong);
  }

  .day__summary {
    cursor: pointer;
    padding: 20px 0;
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 0 14px;
    align-items: start;
  }

  /* The panel runs under the day's text on a phone and beside it once there's
     room. It's inside the <summary> either way, so it reads with the day shut
     — which is the whole point of it for anyone following along. */
  .day__summary > :global(.dstatus) {
    grid-column: 1 / -1;
    margin-top: 13px;
  }

  /* Both chips duplicate what the panel now says properly, at every size.
     Scoped through .day__chips to outrank .day__chip's own display below. */
  .day__chips > .day__chip--elev,
  .day__chips > :global(.wchip) {
    display: none;
  }

  .day__date {
    display: grid;
    justify-items: center;
    gap: 3px;
    padding-top: 2px;
  }

  .day__num {
    font-family: var(--display);
    font-size: var(--fs-daynum);
    line-height: 0.78;
    color: var(--pink);
  }

  .day__month {
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-40);
  }

  .day__head {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .day__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .day__weekday {
    font-weight: 700;
    font-size: var(--fs-micro);
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pink);
  }

  .day__chevron {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink-08);
    display: grid;
    place-items: center;
    font-size: var(--fs-label-sm);
    color: var(--ink-60);
    transition: transform 0.18s ease;
  }
  .day[open] .day__chevron {
    transform: rotate(180deg);
  }

  .day__title {
    font-family: var(--display);
    font-size: var(--fs-daytitle);
    line-height: 1.02;
    text-transform: uppercase;
    font-weight: 400;
    text-wrap: balance;
  }

  .day__star {
    color: var(--gold);
  }

  .day__glance {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--ink-72);
    text-wrap: pretty;
  }

  .day__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: stretch;
  }

  .day__chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    background: var(--ink-07);
    font-weight: 600;
    font-size: var(--fs-label-sm);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Five of the eleven days are mostly getting somewhere — say so up front. */
  .day__chip--travel {
    background: var(--ink);
    color: var(--gold);
    font-weight: 700;
  }

  /* Where today takes you, readable with the day still shut. */
  .day__chip--route {
    background: var(--ink);
    color: var(--cream);
    font-weight: 700;
  }

  .day__chip--route :global(svg) {
    color: var(--gold);
  }

  .day__body {
    padding: 0 0 24px;
    display: grid;
    gap: var(--gap);
  }

  .day__weathernote {
    margin: 0;
    padding-left: 11px;
    border-left: 2px solid var(--pink);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-62);
  }

  .day__block {
    display: grid;
    gap: 8px;
  }

  .day__logistics {
    display: grid;
    gap: 4px;
    font-size: var(--fs-meta);
    line-height: 1.4;
  }

  .day__logistic {
    display: flex;
    gap: 8px;
  }
  .day__logistic::before {
    content: '·';
    color: var(--pink);
    font-weight: 700;
  }

  .day__picks {
    display: grid;
    gap: 12px;
  }

  .day__note {
    margin: 0;
    padding: 11px 13px;
    background: var(--ink-07);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .day__note-label {
    display: block;
    margin-bottom: 3px;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pink);
  }

  /* ── Wide screens ──────────────────────────────────────────────────────
     A day is running prose, so every text block stays at a readable line
     length no matter how wide the column gets. */
  @media (min-width: 1080px) {
    /* The text column is sized to the measure rather than left to stretch, so
       the status panel sits right beside the words instead of across a gap.
       The panel takes whatever is left — a full block, not a floating card. */
    .day__summary {
      grid-template-columns: 64px minmax(0, var(--measure)) minmax(264px, 1fr);
      gap: 0 32px;
    }

    /* Out of the flow and into its own track, level with the day's text. */
    .day__summary > :global(.dstatus) {
      grid-column: auto;
      margin-top: 0;
      align-self: stretch;
    }

    /* The body starts past the date gutter so an open day hangs off its own
       title rather than floating back out to the card edge — that misalignment
       is most of what made a day feel like loose pieces. */
    .day__body {
      padding-left: 96px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      align-items: start;
    }

    /* Running text and the strong bands keep the full width; only the paired
       things — picks, little-black-book panels — share a row. Prose still
       stops at the measure, it just isn't boxed into half the card. */
    .day__body > .day__weathernote,
    .day__body > .day__note,
    .day__body > .day__block,
    .day__body > :global(.travel),
    .day__body > :global(.reservation),
    .day__body > :global(.mapbox) {
      grid-column: 1 / -1;
    }

    .day__weathernote,
    .day__logistics,
    .day__note {
      max-width: var(--measure);
    }

    .day__picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }

    /* An odd last card would otherwise leave a half-row hanging. */
    .day__picks > :global(.place:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
      max-width: var(--measure);
    }

    /* Two panels pair off — matched heights, so the row reads as one band. */
    .day__body > :global(.lbb) {
      align-self: stretch;
    }

    /* A single panel has no partner, so it takes the row. */
    .day__body--lonelbb > :global(.lbb) {
      grid-column: 1 / -1;
    }
  }
</style>
