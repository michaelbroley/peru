---
import type { CollectionEntry } from 'astro:content';
import { MAP_WIDTH, MAP_HEIGHT, project } from '../lib/geo';
import WeatherIcon from './WeatherIcon.astro';

/**
 * The "where are they" panel that runs alongside a day.
 *
 * Family are following along, so it answers three things with the day still
 * collapsed: where in Peru, how high up, and what the weather is doing. It's
 * laid out wide rather than tall so a shut day doesn't leave a hole beside it,
 * and it's all inline SVG and text — nothing to load, reads offline.
 */
interface Props {
  day: CollectionEntry<'days'>['data'];
  /** Every day's point, so the route can be drawn behind today's marker. */
  route: { lat: number; lng: number }[];
  /** The highest point of the trip, for scaling the elevation bar. */
  peak: number;
}
const { day, route, peak } = Astro.props;

const here = project(day.point.lat, day.point.lng);
const line = route.map((p) => project(p.lat, p.lng)).map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`);
const fill = peak > 0 ? Math.max(3, Math.round((day.elevation.metres / peak) * 100)) : 3;
---

<aside class="dstatus" aria-label={`Where we are on ${day.date}`}>
  <svg
    viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
    class="dstatus__svg"
    role="img"
    aria-label={`Map of Peru with ${day.point.label} marked`}
  >
    <g clip-path="url(#geo-frame)">
      <use href="#geo-neighbours" class="dstatus__neighbours" />
      <use href="#geo-peru" class="dstatus__peru" />
      <polyline points={line.join(' ')} class="dstatus__route" />
    </g>
    <circle cx={here.x} cy={here.y} r="10" class="dstatus__halo" />
    <circle cx={here.x} cy={here.y} r="4.8" class="dstatus__here" />
  </svg>

  <div class="dstatus__facts">
    <p class="dstatus__place">{day.point.label}</p>

    <dl class="dstatus__list">
      <div class="dstatus__fact">
        <dt>Elevation</dt>
        <dd>
          <span class="dstatus__value">{day.elevation.label}</span>
          <span class="dstatus__gauge" aria-hidden="true">
            <span class="dstatus__gaugefill" style={`height:${fill}%`}></span>
          </span>
        </dd>
      </div>

      <div class="dstatus__fact">
        <dt>Weather</dt>
        <dd>
          <span class="dstatus__wx" data-daystatus-wx={day.slug}>
            <span class="dstatus__wicon" data-daystatus-wicon>
              <WeatherIcon icon={day.weather.icon} size={15} />
            </span>
            <span class="dstatus__value" data-daystatus-temp>{day.weather.high} / {day.weather.low}</span>
          </span>
        </dd>
      </div>
    </dl>

    <p class="dstatus__note" data-daystatus-note>September average</p>
  </div>
</aside>

<style>
  /* Map beside the facts, not above them — a tall card next to a collapsed
     day is what left a 200px hole in the row. */
  .dstatus {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    padding: 13px 15px 14px;
    background: var(--ink);
    color: var(--cream);
  }

  .dstatus__svg {
    width: 84px;
    height: auto;
    display: block;
    align-self: start;
  }

  /* Neighbours sit well back; Peru reads as the subject. */
  .dstatus__neighbours {
    fill: rgba(255, 251, 245, 0.04);
    stroke: rgba(255, 251, 245, 0.12);
    stroke-width: 0.7;
  }

  .dstatus__peru {
    fill: rgba(255, 251, 245, 0.3);
    stroke: var(--cream);
    stroke-width: 1.4;
  }

  .dstatus__route {
    fill: none;
    stroke: var(--pink);
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 4 3;
  }

  .dstatus__halo {
    fill: var(--gold);
    opacity: 0.3;
  }

  .dstatus__here {
    fill: var(--gold);
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  /* Explicit 0-min tracks throughout: the panel is the narrowest column on
     the page and its labels must be allowed to give, not push the card wide. */
  .dstatus__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 9px;
    min-width: 0;
  }

  .dstatus__place {
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
    font-family: var(--display);
    font-size: 19px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--gold);
  }

  .dstatus__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin: 0;
    padding-top: 9px;
    border-top: 1px solid var(--cream-28);
  }

  /* Flex rather than two tracks so a long value drops under its label on a
     narrow panel instead of shoving the whole card sideways. */
  .dstatus__fact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 3px 8px;
  }

  .dstatus__fact dt {
    min-width: 0;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .dstatus__fact dd {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    min-width: 0;
  }

  .dstatus__value {
    font-weight: 700;
    font-size: var(--fs-meta);
    line-height: 1.1;
    white-space: nowrap;
  }

  /* A vertical gauge reads as height, which is the point. Sea level still
     shows a gold foot so the empty state looks deliberate, not broken. */
  .dstatus__gauge {
    position: relative;
    width: 4px;
    height: 18px;
    background: rgba(255, 251, 245, 0.22);
  }

  .dstatus__gaugefill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 2px;
    background: var(--gold);
  }

  .dstatus__wx {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dstatus__wicon {
    display: flex;
    color: var(--gold);
  }

  .dstatus__note {
    margin: 0;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  /* Set by the clock script when this day is today and a reading has landed. */
  .dstatus[data-live='true'] .dstatus__note {
    color: var(--gold);
    opacity: 1;
  }

  @media print {
    .dstatus {
      background: #fff;
      color: #000;
      border: 1px solid #999;
    }
    .dstatus__place,
    .dstatus__wicon {
      color: #000;
    }
    .dstatus__svg {
      display: none;
    }
  }
</style>
