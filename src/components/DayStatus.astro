---
import type { CollectionEntry } from 'astro:content';
import { MAP_WIDTH, MAP_HEIGHT, project } from '../lib/geo';
import WeatherIcon from './WeatherIcon.astro';

/**
 * The "where are they today" panel, in the space beside a day's summary.
 *
 * Family are following along, so this answers three questions with the day
 * still collapsed: where in Peru, how high up, and what the weather is doing.
 * All of it is inline SVG and text — nothing to load, and it reads offline.
 */
interface Props {
  day: CollectionEntry<'days'>['data'];
  /** Every day's point, so the route can be drawn behind today's marker. */
  route: { lat: number; lng: number }[];
  /** The highest point of the trip, for scaling the elevation bar. */
  peak: number;
}
const { day, route, peak } = Astro.props;

const here = project(day.point.lat, day.point.lng);
const line = route.map((p) => project(p.lat, p.lng)).map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`);

const metres = day.elevation.metres;
const fill = peak > 0 ? Math.max(3, Math.round((metres / peak) * 100)) : 3;
---

<aside class="dstatus" aria-label={`Where we are on ${day.date}`}>
  <div class="dstatus__map">
    <svg
      viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
      class="dstatus__svg"
      role="img"
      aria-label={`Map of Peru with ${day.point.label} marked`}
    >
      <g clip-path="url(#geo-frame)">
        <use href="#geo-neighbours" class="dstatus__neighbours" />
        <use href="#geo-peru" class="dstatus__peru" />
        <polyline points={line.join(' ')} class="dstatus__route" />
      </g>
      <circle cx={here.x} cy={here.y} r="9" class="dstatus__halo" />
      <circle cx={here.x} cy={here.y} r="4.4" class="dstatus__here" />
    </svg>
    <p class="dstatus__place">{day.point.label}</p>
  </div>

  <dl class="dstatus__facts">
    <div class="dstatus__fact">
      <dt>Elevation</dt>
      <dd>
        <span class="dstatus__value">{day.elevation.label}</span>
        <span class="dstatus__gauge" aria-hidden="true">
          <span class="dstatus__gaugefill" style={`height:${fill}%`}></span>
        </span>
      </dd>
    </div>

    <div class="dstatus__fact">
      <dt>Weather</dt>
      <dd>
        <span class="dstatus__wx" data-daystatus-wx={day.slug}>
          <span class="dstatus__wicon" data-daystatus-wicon>
            <WeatherIcon icon={day.weather.icon} size={16} />
          </span>
          <span class="dstatus__value" data-daystatus-temp>{day.weather.high} / {day.weather.low}</span>
        </span>
        <span class="dstatus__note" data-daystatus-note>September average</span>
      </dd>
    </div>
  </dl>
</aside>

<style>
  .dstatus {
    display: grid;
    gap: 12px;
    padding: 12px 13px 13px;
    background: var(--ink);
    color: var(--cream);
  }

  /* ── Locator ───────────────────────────────────────────────────────────── */
  .dstatus__map {
    display: grid;
    justify-items: center;
    gap: 7px;
  }

  .dstatus__svg {
    width: 100%;
    max-width: 138px;
    height: auto;
    display: block;
  }

  /* Neighbours sit well back; Peru needs to read as the subject at 138px. */
  .dstatus__neighbours {
    fill: rgba(255, 251, 245, 0.04);
    stroke: rgba(255, 251, 245, 0.12);
    stroke-width: 0.7;
  }

  .dstatus__peru {
    fill: rgba(255, 251, 245, 0.3);
    stroke: var(--cream);
    stroke-width: 1.2;
  }

  .dstatus__route {
    fill: none;
    stroke: var(--pink);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 3.5 2.5;
  }

  .dstatus__halo {
    fill: var(--gold);
    opacity: 0.28;
  }

  .dstatus__here {
    fill: var(--gold);
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .dstatus__place {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-label-sm);
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    text-align: center;
  }

  /* ── Facts ─────────────────────────────────────────────────────────────── */
  .dstatus__facts {
    display: grid;
    gap: 9px;
    margin: 0;
    padding-top: 11px;
    border-top: 1px solid var(--cream-28);
  }

  .dstatus__fact dt {
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .dstatus__fact dd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 0;
  }

  .dstatus__value {
    font-weight: 700;
    font-size: var(--fs-meta);
    line-height: 1.1;
    white-space: nowrap;
  }

  /* A vertical gauge reads as height, which is the point. */
  .dstatus__gauge {
    position: relative;
    width: 5px;
    height: 20px;
    margin-left: auto;
    background: rgba(255, 251, 245, 0.16);
  }

  .dstatus__gaugefill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gold);
  }

  .dstatus__wx {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .dstatus__wicon {
    display: flex;
    color: var(--gold);
  }

  .dstatus__note {
    margin-left: auto;
    font-size: var(--fs-label-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    text-align: right;
  }

  /* Swapped in by the clock script when this day is today and a live reading
     has arrived. */
  .dstatus__wx[data-live='true'] + .dstatus__note {
    color: var(--gold);
    opacity: 1;
  }

  @media print {
    .dstatus {
      background: #fff;
      color: #000;
      border: 1px solid #999;
    }
    .dstatus__place,
    .dstatus__wicon {
      color: #000;
    }
    .dstatus__svg {
      display: none;
    }
  }
</style>
