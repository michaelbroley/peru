---
import { HABITAT_BACKDROPS } from '../lib/habitat';
import Penguin from './Penguin.astro';
import Choque from './Choque.astro';

/**
 * The footer: 500 px of ground at the bottom of the page for the llama to
 * stand in once you've reached it, and where the penguin lives.
 *
 * She needs no code to get here. She's fixed to the bottom of the viewport,
 * and the bottom of the viewport at full scroll *is* this band — so scrolling
 * to the end walks her out of the guide and into her habitat.
 *
 * The backdrop is picked by the reader's own clock: coast in the morning,
 * valley through the middle of the day, the Andes at dusk, and the night sky
 * after that. It's set from script rather than rendered, so only the one
 * scene that's wanted is ever fetched, and it waits for the guide to finish
 * loading first.
 */
---

<footer class="habitat" data-habitat>
  <div class="habitat__scene" data-habitat-scene aria-hidden="true">
    <span class="habitat__ground"></span>
  </div>

  <Penguin />
  <Choque />
</footer>

<script is:inline type="application/json" data-habitat-config set:html={JSON.stringify(HABITAT_BACKDROPS)} />

<style>
  .habitat {
    position: relative;
    height: 500px;
    /* No negative margin here: the section bands bleed out of the padding
       their <section> carries, but this hangs straight off .shell, which has
       none. It's already the full width of the card. */
    overflow: hidden;
    background: var(--ink);
  }

  .habitat__scene {
    position: absolute;
    inset: 0;
    /* The art is 2356 x 982 with its ground along the bottom edge, so it's
       anchored there and cropped off the top — the floor is the one part that
       has to survive at every width. */
    background-repeat: no-repeat;
    background-position: 50% 100%;
    background-size: cover;
    image-rendering: pixelated;
  }

  /* Stands in until a scene loads, so the band is a horizon rather than a
     hole on a slow connection. */
  .habitat__ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    background: linear-gradient(to bottom, rgba(255, 251, 245, 0.05), rgba(255, 251, 245, 0.09));
    border-top: 2px solid var(--gold);
    opacity: 0.55;
  }

  .habitat__scene[data-loaded] .habitat__ground {
    display: none;
  }

  /* Scenery. Nothing to print. */
  @media print {
    .habitat {
      display: none;
    }
  }
</style>

<script>
  import { backdropForHour } from '../lib/habitat';

  const scene = document.querySelector<HTMLElement>('[data-habitat-scene]');
  const configEl = document.querySelector('[data-habitat-config]');

  if (scene && configEl) {
    const backdrops = JSON.parse(configEl.textContent ?? '[]');
    const chosen = backdropForHour(new Date().getHours());
    const match = backdrops.find((b: { id: string }) => b.id === chosen.id) ?? chosen;

    function paint(): void {
      const img = new Image();
      img.onload = () => {
        scene!.style.backgroundImage = `url(${match.src})`;
        scene!.dataset.loaded = match.id;
      };
      // The drawn horizon is already there; if the scene never arrives it
      // stays, which is a footer rather than a gap.
      img.onerror = () => undefined;
      img.src = match.src;
    }

    if (document.readyState === 'complete') paint();
    else window.addEventListener('load', paint, { once: true });
  }
</script>
