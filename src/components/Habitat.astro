---
import { Image } from 'astro:assets';
import { getCover } from '../lib/covers';

/**
 * The footer: 500 px of ground at the bottom of the page for the llama to
 * stand in once you've reached it.
 *
 * She needs no code to get here. She's fixed to the bottom of the viewport,
 * and the bottom of the viewport at full scroll *is* this band — so scrolling
 * to the end walks her out of the guide and into her habitat.
 *
 * The artwork is a pixel-Peru scene that hasn't landed yet. Until it does the
 * band draws its own horizon, which is deliberate rather than broken: give
 * `cover` a key from src/lib/covers.ts and the picture layers straight over
 * it. If the art has its own horizon rather than sitting on the very bottom
 * edge, set --habitat-floor to how far up from the bottom the ground line is,
 * and she'll stand on that instead.
 */
interface Props {
  /** Key in src/lib/covers.ts. Without one the drawn horizon shows through. */
  cover?: string | undefined;
  /** Distance from the bottom edge up to the ground line in the artwork. */
  floor?: number;
}
const { cover, floor = 0 } = Astro.props;
const image = getCover(cover);
---

<footer class="habitat" data-habitat style={`--habitat-floor:${floor}px`}>
  <div class="habitat__scene" aria-hidden="true">
    {
      image && (
        <Image
          class="habitat__bg"
          src={image.src}
          alt=""
          widths={[640, 1000, 1400, 2000]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span class="habitat__ground"></span>
  </div>
</footer>

<style>
  .habitat {
    position: relative;
    height: 500px;
    /* No negative margin here: the section bands bleed out of the padding
       their <section> carries, but this hangs straight off .shell, which has
       none. It's already the full width of the card. */
    overflow: hidden;
    background: var(--ink);
    /* Read by the llama so she stands on the artwork's ground line rather
       than on the very bottom edge. */
    --habitat-floor: 0px;
  }

  .habitat__scene {
    position: absolute;
    inset: 0;
  }

  .habitat__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    display: block;
    /* Pixel art, if that's what lands here. */
    image-rendering: pixelated;
  }

  /* The stand-in horizon. Once a picture is set this sits under it and stops
     mattering; without one it's a night on the altiplano rather than a hole. */
  .habitat__ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(120px + var(--habitat-floor));
    background: linear-gradient(to bottom, rgba(255, 251, 245, 0.05), rgba(255, 251, 245, 0.09));
    border-top: 2px solid var(--gold);
    opacity: 0.55;
  }

  .habitat:has(.habitat__bg) .habitat__ground {
    display: none;
  }

  /* Scenery. Nothing to print. */
  @media print {
    .habitat {
      display: none;
    }
  }
</style>
