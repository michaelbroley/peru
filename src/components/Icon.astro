  }
  {
    name === 'ticket' && (
      <>
        <path d="M3.5 8.4V6.2h17v2.2a2.6 2.6 0 000 5.2v4.2h-17v-4.2a2.6 2.6 0 000-5.2z" />
        <path d="M13.5 6.2v11.6" stroke-dasharray="2 2.2" />
      </>
    )
  }
  {
    name === 'shirt' && (
      <>
        <path d="M8.6 3.5L4 6.2l1.6 4 2-1v11.3h8.8V9.2l2 1 1.6-4-4.6-2.7z" />
