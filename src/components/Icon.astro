      </>
    )
  }
  {
    name === 'skate' && (
      <>
        <path d="M3.4 8.6c1.6 2.4 4.8 3.6 8.6 3.6s7-1.2 8.6-3.6" />
        <path d="M3.4 8.6a1.9 1.9 0 013.2-1.4M20.6 8.6a1.9 1.9 0 00-3.2-1.4" />
