      </>
    )
  }
  {
    name === 'train' && (
      <>
        <rect x="5" y="3.5" width="14" height="12.5" rx="2.5" />
        <path d="M5 9.5h14M8.5 12.8h.01M15.5 12.8h.01M8 16l-2.5 4.5M16 16l2.5 4.5M7.5 20.5h9" />
      </>
    )
  }
  {
    name === 'bus' && (
      <>
        <rect x="3.5" y="4" width="17" height="12.5" rx="2.5" />
        <path d="M3.5 10.5h17M7.5 13.6h.01M16.5 13.6h.01M7 16.5v2.2M17 16.5v2.2" />
      </>
    )
  }
  {
    name === 'car' && (
      <>
        <path d="M3 14.5l1.6-4.6A2.5 2.5 0 017 8.2h10a2.5 2.5 0 012.4 1.7l1.6 4.6v3.3H3z" />
