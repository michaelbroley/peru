        <path d="M4.8 13.2L6 8.5h12l1.2 4.7M12 8.5V4.8M8.5 4.8h7" />
      </>
    )
  }
  {
    name === 'walk' && (
      <>
        <circle cx="13" cy="4.6" r="1.8" />
