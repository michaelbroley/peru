---
/**
 * The guide's icon set. Inline SVG, one stroke weight, drawn on the same
 * 24×24 grid as the weather glyphs so they sit together.
 *
 * Everything here is decorative — each icon labels text that already says the
 * same thing — so they're hidden from assistive tech by default. Pass a
 * `label` on the rare one that carries meaning of its own.
 */
export type IconName =
  | 'plane-arrive'
  | 'plane-depart'
  | 'plane'
  | 'train'
  | 'bus'
  | 'car'
  | 'boat'
  | 'walk'
  | 'calendar'
  | 'pin'
  | 'fork'
  | 'bag'
  | 'mountain'
  | 'clock'
  | 'ticket'
  | 'shirt'
  | 'sunhat'
  | 'backpack'
  | 'passport'
  | 'fish'
  | 'sandwich'
  | 'glass'
  | 'palette'
  | 'skate'
  | 'column'
  | 'pot'
  | 'terrace'
  | 'market'
  | 'camera';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className = '' } = Astro.props;
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {name === 'plane' && <path d="M21 15.5l-8.5-2.2V6.8a1.6 1.6 0 00-3.2 0v6.5L3 15.5v1.7l6.3-1.4v3.1l-1.9 1.3v1.2l3-.7 3 .7v-1.2l-1.9-1.3v-3.1l6.3 1.4z" />}
  {
    name === 'plane-arrive' && (
      <>
        <path d="M3 20.5h18" />
        <path d="M20.2 8.2a1.5 1.5 0 00-1.9-1L15 8.3 9.6 4.6l-1.8.5 3 5.3-3.4 1.1-2.1-1.6-1.3.4 2 3.6 12.6-3.9a1.5 1.5 0 001-1.4z" />
      </>
    )
  }
  {
    name === 'plane-depart' && (
      <>
