---
/**
 * The day's ordered stops, drawn as a route rather than a sentence.
 *
 * Parenthesised entries ("(train)", "(bus up)") are the mode of travel between
 * places, so they're the connector between two stops rather than a stop.
 *
 * It runs down the page, not across. Laid out horizontally these wrapped into
 * a scatter of small chips that read as tags, which is exactly why the travel
 * — the thing this trip is mostly made of — disappeared into the day.
 *
 * Colours come from the block it sits in, as custom properties, so the route
 * doesn't need to know what it has been dropped onto: --route-stop,
 * --route-end, --route-dot, --route-dot-end, --route-line, --route-via.
 */
interface Props {
  stops: string[];
}
const { stops } = Astro.props;

type Leg = { stop: string; via: string | null };

const legs: Leg[] = [];
let pendingVia: string | null = null;
for (const raw of stops) {
  const isMode = /^\(.*\)$/.test(raw);
  if (isMode) {
    pendingVia = raw.slice(1, -1);
  } else {
    legs.push({ stop: raw, via: pendingVia });
    pendingVia = null;
  }
}
---

<ol class="route">
  {
    legs.map((leg, i) => (
      <li class="route__item">
        {/* A line between every pair, whether or not the mode is named. Drawing
            it only where there was a "(train)" left the unlabelled hops looking
            like a stacked list rather than one continuous route. */}
        {i > 0 && (
          <span class:list={['route__leg', { 'route__leg--bare': !leg.via }]}>
            {leg.via && <span class="route__via">{leg.via}</span>}
          </span>
        )}
        {leg.via && <span class="sr-only">by {leg.via} to</span>}
        <span class="route__stop">
          <span class="route__marker" aria-hidden="true" />
          <span class:list={['route__name', { 'route__name--end': i === legs.length - 1 && legs.length > 1 }]}>
            {leg.stop}
          </span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  /* The defaults are fallbacks at the point of use, never declarations on
     .route itself: a custom property set on an element shadows the one it
     would otherwise inherit, so defining them here would mean a block could
     never colour the route it contains. */
  .route {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One track for the line and its dots, one for the words. */
  .route__stop,
  .route__leg {
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr);
    align-items: center;
    gap: 0 11px;
  }

  .route__marker {
    grid-column: 1;
    justify-self: center;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--route-dot, var(--gold));
  }

  .route__name {
    grid-column: 2;
    font-family: var(--display);
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--route-stop, var(--ink));
  }

  /* Where you end the day, which is the one stop worth finding at a glance. */
  .route__name--end {
    color: var(--route-end, var(--pink));
  }

  .route__item:last-child .route__marker {
    background: var(--route-dot-end, var(--gold));
  }

  /* The line between two stops, carrying how you get along it. */
  .route__leg {
    position: relative;
    min-height: 26px;
  }

  /* Nothing to say about this hop — just enough line to join the dots. */
  .route__leg--bare {
    min-height: 14px;
  }

  .route__leg::before {
    content: '';
    position: absolute;
    /* Centred on the dots: the marker column is 15px, the line 2px. */
    left: 6.5px;
    /* Run under the dots at either end so the chain actually joins up. */
    top: -7px;
    bottom: -7px;
    width: 2px;
    background: var(--route-line, var(--ink-35));
  }

  .route__via {
    grid-column: 2;
    padding: 2px 0;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--route-via, var(--ink-50));
  }

  @media print {
    .route {
      --route-stop: #000;
      --route-end: #000;
      --route-via: #333;
      --route-line: #999;
      --route-dot: #000;
      --route-dot-end: #000;
    }
  }
</style>
