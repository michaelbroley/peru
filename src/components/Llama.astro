---
import {
  LLAMA_ANIMATIONS,
  LLAMA_CELL,
  LLAMA_DAYS,
  LLAMA_SHEET,
  LLAMA_SHEET_COLUMNS,
  LLAMA_SHEET_ROWS,
} from '../lib/llama';

/**
 * Chaska, the 16-bit llama who lives along the bottom of the guide.
 *
 * She has no job. She stands in the corner, occasionally paces, waves, or
 * catches a hoof and falls over; poke her and she spits. On each day of the
 * trip she has something of her own to do — a cocktail on the 16th, the
 * terraces on the 21st, the sun disc on the way home. Once in a blue moon she
 * moonwalks.
 *
 * Turning her off doesn't delete her: she curls up in the left corner and
 * sleeps, which is a nicer thing to have in the corner of a page than nothing.
 *
 * One 14 KB sheet holds all nineteen animations and is fetched after the page
 * has settled, so nothing here competes with the guide loading.
 */
const anims = JSON.stringify(LLAMA_ANIMATIONS);
const days = JSON.stringify(LLAMA_DAYS);
---

<div class="llama" data-llama hidden>
  <button class="llama__hit" type="button" data-llama-poke aria-label="Chaska the llama — poke her">
    <span class="llama__sprite" data-llama-sprite></span>
  </button>
  <p class="llama__say" data-llama-say hidden aria-live="polite"></p>
</div>

<script
  is:inline
  type="application/json"
  data-llama-config
  set:html={JSON.stringify({
    sheet: LLAMA_SHEET,
    cell: LLAMA_CELL,
    columns: LLAMA_SHEET_COLUMNS,
    rows: LLAMA_SHEET_ROWS,
    anims: JSON.parse(anims),
    days: JSON.parse(days),
  })}
/>

<style>
  .llama {
    position: fixed;
    left: 0;
    /* The hooves plant on row 38 of the 40px cell, so the cell's bottom two
       logical pixels are empty — drop it by that much and she stands on the
       floor rather than hovering above it. */
    bottom: calc(var(--safe-bottom) - 4px);
    z-index: 900;
    /* Never in the way of the guide: only her own hit box takes a click. */
    pointer-events: none;
    will-change: transform;
  }

  .llama[hidden] {
    display: none;
  }

  .llama__hit {
    /* The sprite is 80px; the spec asks for a 44px minimum target and this is
       comfortably over it. Transparent, no chrome — she is the button. */
    display: block;
    width: 80px;
    height: 80px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  /* Asleep she is scenery: nothing to click, nothing to tab to. */
  .llama[data-asleep] .llama__hit {
    pointer-events: none;
    cursor: default;
  }

  .llama__hit:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 2px;
  }

  .llama__sprite {
    display: block;
    width: 80px;
    height: 80px;
    background-repeat: no-repeat;
    /* 16-bit art: never let the browser smooth it. */
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    /* A hard offset rather than a blur — she has to read over a photograph as
       well as over cream, and a soft shadow under pixel art looks wrong. */
    filter: drop-shadow(0 3px 0 rgba(18, 16, 15, 0.18));
  }

  /* The art faces right — head, muzzle and the spit all leave to the right —
     so it's walking left that needs the mirror, not walking right. */
  .llama[data-facing='-1'] .llama__sprite {
    transform: scaleX(-1);
  }

  .llama__say {
    position: absolute;
    left: 50%;
    bottom: 74px;
    transform: translateX(-50%);
    margin: 0;
    padding: 5px 9px;
    background: var(--ink);
    color: var(--gold);
    font-weight: 700;
    font-size: var(--fs-label-sm);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .llama__say[hidden] {
    display: none;
  }

  /* She's a treat, not a fixture — leave her off paper entirely. */
  @media print {
    .llama {
      display: none !important;
    }
  }
</style>

<script>
  import { LLAMA_SHEET } from '../lib/llama';

  interface Anim {
    id: string;
    row: number;
    frames: number;
    fps: number;
    backwards?: boolean;
  }
  interface Config {
    sheet: string;
    cell: number;
    columns: number;
    rows: number;
    anims: Record<string, Anim>;
    days: Record<string, { anim: string; say: string }>;
  }

  const KEY = 'peru-llama';
  const root = document.querySelector<HTMLElement>('[data-llama]');
  const sprite = document.querySelector<HTMLElement>('[data-llama-sprite]');
  const hit = document.querySelector<HTMLButtonElement>('[data-llama-poke]');
  const say = document.querySelector<HTMLElement>('[data-llama-say]');
  const configEl = document.querySelector('[data-llama-config]');

  if (root && sprite && hit && say && configEl) {
    const cfg = JSON.parse(configEl.textContent ?? '{}') as Config;
    const A = cfg.anims;

    /* --- Preference ------------------------------------------------------
       On by default, because that's the point of her — except when the reader
       has asked for less motion, where the polite default is off. Either way
       an explicit choice wins and is remembered. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function stored(): boolean | null {
      try {
        const v = localStorage.getItem(KEY);
        return v === null ? null : v === 'on';
      } catch {
        return null;
      }
    }
    let enabled = stored() ?? !reduced;

    /* --- Sprite ---------------------------------------------------------- */
    const CELL = cfg.cell;
    sprite.style.backgroundSize = `${cfg.columns * CELL}px ${cfg.rows * CELL}px`;

    let current: Anim = A.idle!;
    let override: Anim | null = null;
    let overrideUntil = 0;
    let frame = 0;
    let elapsed = 0;
    let last = 0;

    /** Where she is, in px from the left edge, and which way she's pointing. */
    let x = 0;
    /** 1 is the way the art is drawn (facing right); -1 mirrors her. */
    let facing: 1 | -1 = 1;

    /**
     * Which way to point her for a given direction of travel. Everything is
     * drawn facing right and walks the way it faces — except the moonwalk,
     * which is drawn sliding away from the direction she's looking.
     */
    function faceFor(direction: number, anim: Anim): 1 | -1 {
      const forward = direction > 0 ? 1 : -1;
      return (anim.backwards ? -forward : forward) as 1 | -1;
    }

    function point(direction: number, anim: Anim): void {
      facing = faceFor(direction, anim);
      root!.dataset.facing = String(facing);
    }
    let walking = 0; // px/second, 0 when standing still
    let raf = 0;

    /**
     * Her floor is the guide's own card, not the whole monitor: on a wide
     * screen the card is centred with the ink field either side, and a llama
     * straddling that edge reads as a mistake rather than a joke.
     */
    function bounds(): { min: number; max: number } {
      const shell = document.querySelector('.shell')?.getBoundingClientRect();
      const left = shell ? Math.max(0, shell.left + 6) : 6;
      const right = shell ? Math.min(window.innerWidth, shell.right - 6) : window.innerWidth - 6;
      return { min: left, max: Math.max(left, right - CELL) };
    }
    const maxX = () => bounds().max;
    const minX = () => bounds().min;

    function draw(): void {
      const anim = override ?? current;
      sprite!.style.backgroundPosition = `-${frame * CELL}px -${anim.row * CELL}px`;
      root!.style.transform = `translateX(${Math.round(x)}px)`;
    }

    function play(anim: Anim): void {
      if (current === anim) return;
      current = anim;
      frame = 0;
      elapsed = 0;
    }

    /* --- The loop --------------------------------------------------------
       Time-based, not tick-based: frames step on accumulated milliseconds, so
       she runs at the same speed on a 60 Hz laptop and a 120 Hz phone. */
    function tick(now: number): void {
      const dt = last ? Math.min(now - last, 250) : 0;
      last = now;

      if (override && now > overrideUntil) {
        override = null;
        frame = 0;
        elapsed = 0;
      }

      const anim = override ?? current;
      elapsed += dt;
      const step = 1000 / anim.fps;
      while (elapsed >= step) {
        elapsed -= step;
        frame = (frame + 1) % anim.frames;
      }

      if (walking !== 0) {
        x += (walking * dt) / 1000;
        // Turn at the edges rather than walking off.
        if (x <= minX() || x >= maxX()) {
          x = Math.max(minX(), Math.min(x, maxX()));
          walking = -walking;
          point(walking, override ?? current);
        }
      }

      draw();
      raf = requestAnimationFrame(tick);
    }

    /* --- What she decides to do ------------------------------------------
       A queue of one-shots on timers. Nothing here is clever: she stands
       around, and every so often does something. */
    /**
     * Every pending piece of behaviour, so a state change can cancel all of it
     * at once. A stray `stand()` landing after she's gone to sleep would stand
     * her up asleep, which is exactly the kind of bug a mascot gets away with
     * for months.
     */
    const pending = new Set<number>();
    function later(fn: () => void, ms: number): void {
      const id = window.setTimeout(() => {
        pending.delete(id);
        fn();
      }, ms);
      pending.add(id);
    }
    function clearPending(): void {
      for (const id of pending) window.clearTimeout(id);
      pending.clear();
    }

    const rand = (min: number, max: number) => min + Math.random() * (max - min);

    function stand(): void {
      walking = 0;
      play(A.idle!);
    }

    let speakTimer = 0;
    function speak(text: string, ms = 2200): void {
      say!.textContent = text;
      say!.hidden = false;
      // Centred over her by default, then nudged back inside the viewport —
      // she talks from the corners, where a centred label hangs off the edge.
      say!.style.transform = 'translateX(-50%)';
      const box = say!.getBoundingClientRect();
      let shift = 0;
      if (box.left < 6) shift = 6 - box.left;
      else if (box.right > window.innerWidth - 6) shift = window.innerWidth - 6 - box.right;
      if (shift) say!.style.transform = `translateX(calc(-50% + ${Math.round(shift)}px))`;

      window.clearTimeout(speakTimer);
      speakTimer = window.setTimeout(() => {
        say!.hidden = true;
      }, ms);
    }

    /** Today's animation, if today is one of the eleven. */
    function todaysAct(): { anim: string; say: string } | undefined {
      const now = new Date();
      const iso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(
        now.getDate(),
      ).padStart(2, '0')}`;
      return cfg.days[iso];
    }

    /**
     * Head for somewhere else on the floor and walk there. `anim` is normally
     * the gallop; once in a while it's the moonwalk, which glides rather than
     * runs and so travels slower.
     */
    function pace(anim: Anim = A.run!, speed = 42): number {
      const target = rand(minX(), maxX());
      walking = target > x ? speed : -speed;
      point(walking, anim);
      play(anim);
      const ms = (Math.abs(target - x) / speed) * 1000;
      later(stand, ms);
      return ms + 400;
    }

    function oneShot(anim: Anim, cycles = 2): number {
      walking = 0;
      play(anim);
      return (anim.frames / anim.fps) * 1000 * cycles;
    }

    function act(): void {
      const today = todaysAct();
      const roll = Math.random();

      let hold: number;
      if (roll < 0.06) {
        // Once in a blue moon. Deliberately the first branch so it can't be
        // squeezed out on the days she has a turn of her own.
        hold = pace(A.moonwalk!, 26);
      } else if (today && roll < 0.44) {
        // Her party piece for the day gets the biggest share.
        hold = oneShot(A[today.anim] ?? A.idle!, 3);
        speak(today.say);
      } else if (roll < 0.62) {
        hold = pace();
      } else if (roll < 0.76) {
        hold = oneShot(A.wave!, 2);
      } else if (roll < 0.86) {
        // Catches a hoof and goes over. Plays once — it's a pratfall, not a
        // habit.
        hold = oneShot(A.trip!, 1);
      } else {
        hold = oneShot(A.dance!, 2);
      }

      later(() => {
        stand();
        later(act, rand(14000, 38000));
      }, hold);
    }

    /* --- Poke ------------------------------------------------------------
       An interrupt, not a queue: a second poke restarts the spit rather than
       stacking. */
    hit.addEventListener('click', () => {
      override = A.tap!;
      frame = 0;
      elapsed = 0;
      overrideUntil = performance.now() + 700;
    });

    /* --- On / off --------------------------------------------------------- */
    function start(): void {
      clearPending();
      root!.hidden = false;
      delete root!.dataset.asleep;
      hit!.setAttribute('aria-label', 'Chaska the llama — poke her');
      x = Math.max(x, minX());
      root!.dataset.facing = '1';
      facing = 1;
      stand();
      last = 0;
      if (!raf) raf = requestAnimationFrame(tick);
      const today = todaysAct();
      // Say hello on arrival, or show off if it's one of her days.
      later(() => {
        if (today) {
          play(A[today.anim] ?? A.wave!);
          speak(today.say, 3000);
          later(stand, 3200);
        } else {
          play(A.wave!);
          later(stand, 1500);
        }
        later(act, rand(9000, 20000));
      }, 900);
    }

    /**
     * Off doesn't delete her: she curls up in the corner and sleeps. She stops
     * wandering, stops being a button, and stops talking — a sleeping llama in
     * the corner of a page is a nicer thing to have there than nothing.
     *
     * Frozen mid-stride would read as a bug, which is what the handoff warns
     * against; asleep reads as asleep.
     */
    function goToSleep(): void {
      clearPending();
      window.clearTimeout(speakTimer);
      walking = 0;
      override = null;
      say!.hidden = true;
      root!.hidden = false;
      root!.dataset.asleep = '';
      root!.dataset.facing = '1';
      facing = 1;
      hit!.setAttribute('aria-label', 'Chaska the llama, asleep');
      x = minX();
      play(A.sleep!);

      if (reduced) {
        // Someone who asked for less motion gets a still llama, not a
        // slow-breathing one. One frame, no loop.
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        frame = 0;
        draw();
        return;
      }
      last = 0;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    function setEnabled(on: boolean, remember = true): void {
      enabled = on;
      if (remember) {
        try {
          localStorage.setItem(KEY, on ? 'on' : 'off');
        } catch {
          /* no storage — she just won't be remembered */
        }
      }
      for (const button of document.querySelectorAll<HTMLElement>('[data-llama-toggle]')) {
        button.setAttribute('aria-pressed', String(on));
        const label = button.querySelector('[data-llama-toggle-label]');
        if (label) label.textContent = on ? 'On' : 'Off';
      }
      // One switch for the whole menagerie — the penguin in the footer takes
      // his cue from this too.
      document.dispatchEvent(new CustomEvent('peru:llama', { detail: { enabled: on } }));
      if (on) start();
      else goToSleep();
    }

    for (const button of document.querySelectorAll<HTMLElement>('[data-llama-toggle]')) {
      button.addEventListener('click', () => setEnabled(!enabled));
    }

    window.addEventListener(
      'resize',
      () => {
        x = Math.max(minX(), Math.min(x, maxX()));
      },
      { passive: true },
    );

    /* This page gets left open. There's no reason to keep a llama animating in
       a tab nobody is looking at. */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      } else if (!raf && !root!.hidden && !(reduced && root!.hasAttribute('data-asleep'))) {
        last = 0;
        raf = requestAnimationFrame(tick);
      }
    });

    /* --- Bring her in ----------------------------------------------------
       The sheet is 174 KB and she is not the point of the page, so she waits
       for everything else to finish before fetching anything. */
    function summon(): void {
      const img = new Image();
      img.onload = () => {
        sprite!.style.backgroundImage = `url(${LLAMA_SHEET})`;
        setEnabled(enabled, false);
      };
      // No llama is better than a broken one; fail silently.
      img.onerror = () => undefined;
      img.src = LLAMA_SHEET;
    }

    // Reflect the stored preference on the toggle straight away, even though
    // she hasn't arrived yet.
    for (const button of document.querySelectorAll<HTMLElement>('[data-llama-toggle]')) {
      button.setAttribute('aria-pressed', String(enabled));
      const label = button.querySelector('[data-llama-toggle-label]');
      if (label) label.textContent = enabled ? 'On' : 'Off';
    }

    /** Safari has no requestIdleCallback; a short timer is close enough. */
    function whenIdle(fn: () => void): void {
      const ric = (window as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
      if (typeof ric === 'function') ric(fn);
      else window.setTimeout(fn, 1200);
    }

    if (document.readyState === 'complete') whenIdle(summon);
    else window.addEventListener('load', () => whenIdle(summon), { once: true });
  }
</script>
