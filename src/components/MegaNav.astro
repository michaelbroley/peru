---
/**
 * The guide's navigation: a slim sticky bar and a mega panel.
 *
 * The bar carries only what's useful while you're reading — where you
 * currently are, a jump to today, and the menu trigger. Everything else lives
 * in the panel, which opens as one view of the whole guide: sections, all
 * eleven days, all twelve recommendation categories, and the lens filter.
 *
 * It behaves like a menu rather than a table of contents: one trigger, one
 * surface, closes on selection, Escape or a click outside, and keeps focus
 * inside while it's open.
 *
 * The recommendations column is grouped by the same chapters the section is,
 * with the chapter's name dropped off each row — "Lima — Ceviche & seafood"
 * under a "Lima" heading says it twice.
 */
interface TocItem {
  href: string;
  label: string;
  /** Section number, where there is one. */
  num?: string;
  /** Day date, shown as the lead-in on a day row. */
  meta?: string;
  /** Chapter heading to print above this row, on the first row of a chapter. */
  group?: string;
}
interface Props {
  sections: TocItem[];
  days: TocItem[];
  categories: TocItem[];
}
const { sections, days, categories } = Astro.props;
---

<nav class="nav" id="toc" aria-label="Guide">
  <div class="nav__bar">
    <p class="nav__here">
      <span class="nav__here-label">You're in</span>
      <span class="nav__here-value" data-nav-current>Trip snapshot</span>
    </p>

    <div class="nav__actions">
      <a class="nav__today" href="#day-by-day" data-nav-today>
        <span class="nav__today-dot" aria-hidden="true"></span>
        <span data-nav-today-label>Today</span>
      </a>

      <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <span class="nav__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="nav__trigger-label">Menu</span>
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" hidden data-nav-panel>
    <div class="nav__cols">
      <section class="nav__col">
        <h2 class="nav__coltitle">Sections</h2>
        <ul class="nav__list">
          {
            sections.map((item) => (
              <li>
                <a class="nav__link nav__link--section" href={item.href} data-nav-link data-nav-section-link>
                  <span class="nav__num" aria-hidden="true">
                    {item.num}
                  </span>
                  <span data-nav-label>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="nav__col">
        <h2 class="nav__coltitle">Day by day</h2>
        <ul class="nav__list">
          {
            days.map((item) => (
              <li>
                <a class="nav__link nav__link--day" href={item.href} data-nav-link data-nav-day={item.href.slice(1)}>
                  <span class="nav__daydate">{item.meta}</span>
                  <span class="nav__daytitle">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="nav__col">
        <h2 class="nav__coltitle">Recommendations</h2>
        <ul class="nav__list">
          {
            categories.map((item) => (
              <Fragment>
                {item.group && <li class="nav__group">{item.group}</li>}
                <li>
                  <a class="nav__link" href={item.href} data-nav-link>
                    {item.label}
                  </a>
                </li>
              </Fragment>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="nav__lens" role="group" aria-label="Filter recommendations">
      <span class="nav__lenslabel">Lens</span>
      <button class="nav__pill" type="button" data-lens-btn="all" aria-pressed="true">Everything</button>
      <button class="nav__pill" type="button" data-lens-btn="food" aria-pressed="false">Laura’s food</button>
      <button class="nav__pill" type="button" data-lens-btn="skate" aria-pressed="false">Michael’s skate</button>

      {/* Chaska has nothing to do with navigating the guide, but this is the
          one panel that holds every switch, so it's where you'd look. */}
      <span class="nav__lenslabel nav__lenslabel--llama">Llama</span>
      <button class="nav__pill" type="button" data-llama-toggle aria-pressed="true">
        <span data-llama-toggle-label>On</span>
      </button>
    </div>
  </div>
</nav>

<div class="nav__backdrop" hidden data-nav-backdrop></div>

<script>
  const nav = document.getElementById('toc');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const current = document.querySelector<HTMLElement>('[data-nav-current]');

  /* --- Sticky offset ------------------------------------------------------
     Only the bar overlaps the content; the panel floats over it. */
  if (nav) {
    const bar = nav.querySelector<HTMLElement>('.nav__bar');
    const setNavHeight = () => {
      document.documentElement.style.setProperty('--nav-h', `${bar?.offsetHeight ?? 0}px`);
    };
    setNavHeight();
    if (typeof ResizeObserver === 'function' && bar) new ResizeObserver(setNavHeight).observe(bar);
    else window.addEventListener('resize', setNavHeight, { passive: true });
  }

  /* --- Open / close -------------------------------------------------------- */
  const FOCUSABLE = 'a[href], button:not([disabled])';
  let lastFocus: HTMLElement | null = null;

  function isOpen(): boolean {
    return !!panel && !panel.hidden;
  }

  function open(): void {
    if (!panel || !toggle) return;
    lastFocus = document.activeElement as HTMLElement;
    panel.hidden = false;
    if (backdrop) backdrop.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
  }

  function close({ restoreFocus = true } = {}): void {
    if (!panel || !toggle) return;
    panel.hidden = true;
    if (backdrop) backdrop.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    if (restoreFocus) (lastFocus ?? toggle).focus();
  }

  toggle?.addEventListener('click', () => (isOpen() ? close() : open()));
  backdrop?.addEventListener('click', () => close());

  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      close();
      return;
    }

    // Keep tabbing inside the panel while it's the thing on screen.
    if (event.key === 'Tab' && panel) {
      const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null,
      );
      if (!items.length) return;
      const first = items[0]!;
      const last = items.at(-1)!;
      const active = document.activeElement;
      if (event.shiftKey && (active === first || active === toggle)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  /* --- Jumping ------------------------------------------------------------- */
  function openTarget(hash: string): void {
    let target: Element | null = null;
    try {
      target = document.querySelector(hash);
    } catch {
      return;
    }
    if (!target) return;

    // Every disclosure above the target, not just the nearest: a day sits
    // inside its own <details> inside the section's fold.
    let details = target.closest('details');
    while (details) {
      details.open = true;
      details = details.parentElement?.closest('details') ?? null;
    }

    // Jumping at a whole section means opening its fold, which is inside it.
    target.querySelector<HTMLDetailsElement>(':scope > [data-section-fold]')?.setAttribute('open', '');
  }

  for (const link of links) {
    link.addEventListener('click', () => {
      openTarget(link.getAttribute('href') ?? '');
      // Focus belongs on the destination, not back on the trigger.
      close({ restoreFocus: false });
    });
  }

  document.querySelector('[data-nav-today]')?.addEventListener('click', (event) => {
    const href = (event.currentTarget as HTMLAnchorElement).getAttribute('href') ?? '';
    openTarget(href);
  });

  function handleHash(): void {
    if (!location.hash) return;
    let hash = location.hash;
    try {
      hash = decodeURIComponent(location.hash);
    } catch {
      /* keep the raw hash */
    }
    openTarget(hash);
    document.querySelector(hash)?.scrollIntoView({ block: 'start' });
  }
  window.addEventListener('hashchange', handleHash);
  handleHash();

  /* --- Where am I ---------------------------------------------------------- */
  const watched = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
  const sectionLinks = new Map<string, HTMLAnchorElement>();
  for (const link of links) {
    // The marker is a valueless attribute, so `dataset` gives "" — falsy.
    if (!link.hasAttribute('data-nav-section-link')) continue;
    const id = link.getAttribute('href')?.slice(1);
    if (id) sectionLinks.set(decodeURIComponent(id), link);
  }

  if (watched.length && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const active = watched.find((section) => visible.has(section.id));
        if (!active) return;

        // Read the label span, not the whole link — the number is in there too.
        const link = sectionLinks.get(active.id);
        const label = link?.querySelector('[data-nav-label]')?.textContent?.trim();
        if (current && label) current.textContent = label;

        for (const [id, item] of sectionLinks) {
          const on = id === active.id;
          item.classList.toggle('is-active', on);
          if (on) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 },
    );
    for (const section of watched) observer.observe(section);
  }

  /* --- Lens ---------------------------------------------------------------- */
  const lensButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lens-btn]'));
  for (const button of lensButtons) {
    button.addEventListener('click', () => {
      const lens = button.dataset.lensBtn ?? 'all';
      if (lens === 'all') delete document.documentElement.dataset.lens;
      else document.documentElement.dataset.lens = lens;
      for (const other of lensButtons) {
        const on = other === button;
        other.setAttribute('aria-pressed', String(on));
        other.classList.toggle('is-active', on);
      }
    });
  }
  lensButtons.find((b) => b.dataset.lensBtn === 'all')?.classList.add('is-active');
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* Above Leaflet's controls, which sit at 1000 inside their own card. */
    z-index: 1200;
  }

  /* ── The bar ───────────────────────────────────────────────────────────── */
  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    background: var(--ink);
    color: var(--cream);
    box-shadow: var(--shadow-nav);
  }

  .nav__here {
    display: grid;
    gap: 2px;
    margin: 0;
    min-width: 0;
  }

  .nav__here-label {
    font-weight: 600;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .nav__here-value {
    font-family: var(--display);
    font-size: 19px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--cream);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
  }

  .nav__today,
  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: var(--fs-label-sm);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .nav__today {
    background: transparent;
    border: 1px solid var(--cream-28);
    color: var(--cream);
    text-decoration: none;
  }
  .nav__today:hover,
  .nav__today:focus-visible {
    border-color: var(--gold);
    color: var(--gold);
  }

  .nav__today-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .nav__trigger {
    background: var(--pink);
    border: 1px solid var(--pink);
    color: var(--cream);
  }
  .nav__trigger:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }

  .nav__bars {
    display: grid;
    gap: 3px;
    width: 14px;
  }
  .nav__bars span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .nav__trigger[aria-expanded='true'] .nav__bars span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .nav__trigger[aria-expanded='true'] .nav__bars span:nth-child(2) {
    opacity: 0;
  }
  .nav__trigger[aria-expanded='true'] .nav__bars span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* ── The panel ─────────────────────────────────────────────────────────── */
  /* Fixed, not part of the sticky flow: anchoring it to the viewport keeps it
     put while the page scrolls behind, and avoids locking body scroll — which
     would remove the scrollport the bar itself sticks to. */
  .nav__panel {
    position: fixed;
    top: var(--nav-h, 58px);
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, var(--wrap));
    max-height: calc(100vh - var(--nav-h, 58px));
    max-height: calc(100dvh - var(--nav-h, 58px));
    background: var(--ink);
    color: var(--cream);
    border-top: 1px solid var(--cream-28);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 14px 20px;
  }

  /* `display: grid` below would otherwise beat the UA's [hidden] rule. */
  .nav__panel[hidden] {
    display: none;
  }

  .nav__cols {
    display: grid;
    gap: 4px;
  }

  .nav__coltitle {
    margin: 16px 0 6px;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .nav__list {
    display: grid;
  }

  /* Chapter headings inside the recommendations column, matching the bands
     the section itself is now divided by. */
  .nav__group {
    margin: 12px 0 3px;
    padding-top: 10px;
    border-top: 1px solid var(--cream-25);
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream-55);
  }

  .nav__group:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .nav__link {
    display: block;
    padding: 9px 8px 9px 0;
    color: var(--cream);
    text-decoration: none;
    font-size: var(--fs-note);
    line-height: 1.3;
    border-bottom: 1px solid rgba(255, 251, 245, 0.1);
    transition: color 0.12s ease, padding-left 0.12s ease;
  }
  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--gold);
    padding-left: 5px;
  }

  .nav__link--section {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--display);
    font-size: 21px;
    text-transform: uppercase;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .nav__num {
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    color: var(--pink);
    flex: 0 0 auto;
  }

  .nav__link--section.is-active {
    color: var(--gold);
  }
  .nav__link--section.is-active .nav__num {
    color: var(--gold);
  }

  .nav__link--day {
    display: grid;
    gap: 1px;
  }

  .nav__daydate {
    font-weight: 700;
    font-size: var(--fs-label-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink);
  }

  .nav__daytitle {
    font-size: var(--fs-meta);
  }

  /* Today's row, marked by the header script. */
  .nav__link--day.is-today .nav__daydate {
    color: var(--gold);
  }
  .nav__link--day.is-today .nav__daytitle {
    font-weight: 700;
  }

  .nav__lens {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--cream-28);
  }

  .nav__lenslabel--llama {
    margin-left: auto;
  }

  .nav__lenslabel {
    font-weight: 700;
    font-size: var(--fs-label-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-right: 4px;
  }

  .nav__pill {
    padding: 9px 12px;
    background: transparent;
    border: 1px solid var(--cream-28);
    border-radius: var(--radius-pill);
    color: var(--cream);
    font-weight: 600;
    font-size: var(--fs-label-sm);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  .nav__pill:hover {
    border-color: var(--gold);
  }
  .nav__pill.is-active {
    background: var(--pink);
    border-color: var(--pink);
  }

  /* ── Wider ─────────────────────────────────────────────────────────────── */
  @media (min-width: 720px) {
    .nav__bar {
      padding: 11px 20px;
    }
    .nav__here-value {
      font-size: 23px;
    }
    .nav__panel {
      padding: 8px 20px 24px;
    }
    .nav__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 28px;
      align-items: start;
    }
    .nav__coltitle {
      margin-top: 18px;
    }
  }

  @media (min-width: 1080px) {
    .nav__bar {
      padding: 12px var(--pad);
    }
    .nav__panel {
      padding: 10px var(--pad) 30px;
    }
    .nav__cols {
      gap: 0 44px;
    }
  }

  @media print {
    .nav {
      display: none;
    }
  }
</style>

<style is:global>
  .nav__backdrop {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: rgba(18, 16, 15, 0.5);
  }
  .nav__backdrop[hidden] {
    display: none;
  }
</style>
