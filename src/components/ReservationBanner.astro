---
import { Image } from 'astro:assets';
import { gmapsUrl, telUrl, placeQuery } from '../lib/links';
import { getCover } from '../lib/covers';
import Icon from './Icon.astro';

/**
 * A booked table — Lady Bee, Maido, the Machu Picchu tour. Pink-boxed, the
 * design's loudest block, and the one thing on a day that can't be moved.
 *
 * With a photograph it becomes the day's centrepiece rather than another
 * bordered paragraph. The picture sits beside the words on anything wider
 * than a phone and above them below that.
 */
interface Props {
  name: string;
  time: string;
  address?: string | undefined;
  phone?: string | undefined;
  note: string;
  /** Shown in the eyebrow: "★ Reservation · 8:00 PM". */
  showTimeInEyebrow?: boolean;
  /** Off inside the snapshot's "★ Booked reservations" box, which labels itself. */
  showEyebrow?: boolean;
  headingLevel?: 'h3' | 'h4';
  /** Key in src/lib/covers.ts. Without one the banner is text, as before. */
  cover?: string | undefined;
}
const {
  name,
  time,
  address,
  phone,
  note,
  showTimeInEyebrow = true,
  showEyebrow = true,
  headingLevel = 'h4',
  cover,
} = Astro.props;

const image = getCover(cover);

const mapHref = address ? gmapsUrl(placeQuery(name, address)) : null;
const telHref = phone ? telUrl(phone) : null;
// Addresses are stored with the venue name up front for a better maps hit;
// the label drops it since the name is already the heading.
const addressLabel = address?.startsWith(`${name}, `) ? address.slice(name.length + 2) : address;
const Heading = headingLevel;
---

<aside
  class:list={['reservation', { 'reservation--photo': !!image }]}
  aria-label={`Booked reservation: ${name}`}
>
  {
    image && (
      <div class="reservation__media">
        <Image
          class="reservation__img"
          src={image.src}
          alt={image.alt}
          widths={[400, 640, 960]}
          sizes="(min-width: 700px) 340px, 100vw"
          loading="lazy"
          decoding="async"
          style={image.focus ? `object-position:${image.focus}` : undefined}
        />
      </div>
    )
  }

  <div class="reservation__text">
  {showEyebrow && <p class="reservation__eyebrow"><Icon name="ticket" size={15} /><span class="reservation__booked">Booked</span>{showTimeInEyebrow ? <span class="reservation__when">{time}</span> : ''}</p>}
  <Heading class="reservation__name">{name}</Heading>
  {!showTimeInEyebrow && <p class="reservation__when-line">{time}</p>}

  <p class="reservation__body">{note}</p>

  {/* Address and phone get their own row rather than being threaded through
      the sentence — a long venue address wraps, and its full stop ends up
      stranded at the start of the next line. */}
  {
    (mapHref || telHref) && (
      <p class="reservation__links">
        {mapHref && addressLabel && (
          <a
            class="res__link"
            href={mapHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${name} in Google Maps — ${addressLabel}`}
          >
            {addressLabel}
          </a>
        )}
        {telHref && phone && (
          <a class="res__link" href={telHref} aria-label={`Call ${name} on ${phone}`}>
            {phone}
          </a>
        )}
      </p>
    )
  }
  </div>
</aside>

<style>
  .reservation {
    border: 2px solid var(--pink);
    padding: 14px;
  }

  /* With a photograph the border wraps the whole thing and the padding moves
     inside, so the picture runs to the pink edge. */
  .reservation--photo {
    display: grid;
    padding: 0;
  }

  .reservation--photo .reservation__text {
    padding: 14px;
  }

  .reservation__media {
    overflow: hidden;
    background: var(--ink);
  }

  .reservation__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reservation--photo .reservation__media {
    height: clamp(150px, 40vw, 210px);
  }

  /* Beside the words as soon as there's room for both to be worth reading.
     A proportion rather than a fixed width: the banner runs the full width of
     an open day, and 300px of photograph across 1,100 is a strip, not a
     picture. The minimum height stops a short booking flattening it. */
  @media (min-width: 700px) {
    .reservation--photo {
      grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
      align-items: stretch;
      min-height: 190px;
    }

    .reservation--photo .reservation__media {
      height: 100%;
    }

    .reservation--photo .reservation__text {
      align-self: center;
      padding: 16px 18px;
    }
  }

  @media (min-width: 1080px) {
    .reservation--photo {
      min-height: 230px;
    }
  }

  /* Photographs are screen furniture; the booking itself still prints. */
  @media print {
    .reservation__media {
      display: none;
    }
    .reservation--photo {
      display: block;
      padding: 14px;
    }
    .reservation--photo .reservation__text {
      padding: 0;
    }
  }

  .reservation__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 2px;
    font-weight: 700;
    font-size: var(--fs-label-sm);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pink);
  }

  /* A booked table is the one thing on a day you cannot miss — say the word. */
  .reservation__when {
    min-width: 0;
  }

  .reservation__booked {
    padding: 4px 7px;
    background: var(--pink);
    color: var(--cream);
    letter-spacing: 0.18em;
  }

  .reservation__name {
    margin: 7px 0 0;
    font-family: var(--display);
    font-size: var(--fs-resname);
    line-height: 1.05;
    text-transform: uppercase;
    font-weight: 400;
  }

  .reservation__when-line {
    margin: 6px 0 0;
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
    color: var(--pink);
  }

  .reservation__body {
    margin: 6px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .reservation__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 7px 0 0;
    font-size: var(--fs-small);
  }

  .res__link {
    display: inline-block;
    padding: 3px 0;
    min-height: 22px;
  }
</style>
