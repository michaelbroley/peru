---
/**
 * A soft edge at the top and bottom of the viewport while you're scrolling.
 *
 * Content doesn't cut off at the edge of the screen so much as dissolve into
 * it, which makes a very long page feel like it's passing through a window
 * rather than jumping in a box. It's only there while you're moving: at rest
 * it fades out completely, so nothing is ever permanently veiled.
 *
 * Three stacked layers per edge rather than one. A single masked blur fades
 * the blurred copy out against the sharp original underneath, which reads as a
 * ghosted double image; stacking blurs that each cover less of the band means
 * every layer filters the one below it, and the strength ramps instead.
 */
---

<div class="edge" data-scroll-edge aria-hidden="true" hidden>
  <div class="edge__band edge__band--top">
    <span class="edge__layer edge__layer--1"></span>
    <span class="edge__layer edge__layer--2"></span>
    <span class="edge__layer edge__layer--3"></span>
  </div>
  <div class="edge__band edge__band--bottom" data-edge-bottom>
    <span class="edge__layer edge__layer--1"></span>
    <span class="edge__layer edge__layer--2"></span>
    <span class="edge__layer edge__layer--3"></span>
  </div>
</div>

<style>
  .edge {
    position: fixed;
    inset: 0;
    /* Over the guide, under the llama (900) and well under the nav (1200):
       the mascot is pixel art and the bar is the one thing you navigate by.
       Neither should ever go soft. */
    z-index: 800;
    pointer-events: none;
  }

  .edge[hidden] {
    display: none;
  }

  .edge__band {
    position: absolute;
    left: 0;
    right: 0;
    height: 88px;
  }

  /* Below the bar, not behind it — the bar is opaque ink, so a band starting
     at 0 would spend two thirds of itself invisible and then start abruptly. */
  .edge__band--top {
    top: var(--nav-h, 58px);
  }

  .edge__band--bottom {
    bottom: 0;
  }

  .edge__layer {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    /* The fade lives on the layers themselves. An ancestor with opacity would
       make itself a backdrop root, and every backdrop-filter inside it would
       then be filtering an empty backdrop — no blur at all, silently. */
    transition: opacity 260ms ease;
  }

  .edge.is-on .edge__layer {
    opacity: 1;
  }

  /* Each layer blurs the result of the one beneath it and covers less of the
     band, so the softness ramps toward the edge instead of stepping. */
  .edge__band--top .edge__layer--1 {
    -webkit-backdrop-filter: blur(1.5px);
    backdrop-filter: blur(1.5px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
  }

  .edge__band--top .edge__layer--2 {
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 62%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 62%);
  }

  .edge__band--top .edge__layer--3 {
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 30%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 30%);
  }

  .edge__band--bottom .edge__layer--1 {
    -webkit-backdrop-filter: blur(1.5px);
    backdrop-filter: blur(1.5px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
    mask-image: linear-gradient(to top, #000 0%, transparent 100%);
  }

  .edge__band--bottom .edge__layer--2 {
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 62%);
    mask-image: linear-gradient(to top, #000 0%, transparent 62%);
  }

  .edge__band--bottom .edge__layer--3 {
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 30%);
    mask-image: linear-gradient(to top, #000 0%, transparent 30%);
  }

  /* The llama stays sharp because she's above this, so blurring the ground she
     stands on would leave her crisp on a soft floor. Once the habitat is in
     view the bottom edge stands down. */
  .edge[data-floor] .edge__band--bottom .edge__layer {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      display: none;
    }
  }

  @media print {
    .edge {
      display: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-scroll-edge]');

  /* No point running any of this where the effect can't render, or for anyone
     who has asked for less movement. */
  const wanted =
    root &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    (CSS.supports('backdrop-filter', 'blur(1px)') || CSS.supports('-webkit-backdrop-filter', 'blur(1px)'));

  if (wanted) {
    /** Long enough to outlast the gaps in a flick, short enough to feel tied to the scroll. */
    const REST = 180;
    const FADE = 260;

    let idle = 0;
    let clear = 0;
    let on = false;

    function show(): void {
      if (!on) {
        on = true;
        window.clearTimeout(clear);
        root!.hidden = false;
        // A frame between unhiding and the class, or there's nothing for the
        // transition to run from and it snaps on.
        requestAnimationFrame(() => {
          if (on) root!.classList.add('is-on');
        });
      }
      window.clearTimeout(idle);
      idle = window.setTimeout(rest, REST);
    }

    function rest(): void {
      if (!on) return;
      on = false;
      root!.classList.remove('is-on');
      // Out of the compositor entirely once it's invisible: three backdrop
      // filters are not something to leave running behind a page at rest.
      clear = window.setTimeout(() => {
        if (!on) root!.hidden = true;
      }, FADE);
    }

    window.addEventListener('scroll', show, { passive: true });

    // The menagerie's own floor is never blurred.
    const habitat = document.querySelector('[data-habitat]');
    if (habitat && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry!.isIntersecting) root!.dataset.floor = '';
          else delete root!.dataset.floor;
        },
        { threshold: 0 },
      ).observe(habitat);
    }

    // Nothing to soften while the tab is in the background.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) rest();
    });
  }
</script>
