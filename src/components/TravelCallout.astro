---
import Icon, { type IconName } from './Icon.astro';
import JourneyStrip from './JourneyStrip.astro';

/**
 * Where today takes you, and how long it takes.
 *
 * Nine of the eleven days move somewhere, so this is the first block in a day
 * — before the weather, before the logistics. It used to be two things: a
 * transit card here and a strip of stops further down, each saying a version
 * of the same route. Split like that neither one carried, and on a day with no
 * duration to quote (a led walk downtown) all you got was the strip, which
 * read as a row of tags.
 *
 * One block now: the mode and the clock across the top, the route itself as
 * the body, the day's travel notes underneath. `detail` is the prose version
 * of the route, so it only appears when there are no stops to draw.
 */
interface Props {
  mode?: string | undefined;
  /** "~7.5 hrs", "First bus 6:00 AM" — the headline number. */
  duration?: string | undefined;
  /** "Cusco → Altiplano → Puno" — the fallback where there is no stop list. */
  detail?: string | undefined;
  /** "Depart hotel 5:30 AM" and friends. */
  notes?: string[];
  /** The day's ordered stops, modes of travel in parentheses. */
  stops?: string[];
}
const { mode, duration, detail, notes = [], stops = [] } = Astro.props;

const icons: Record<string, IconName> = {
  plane: 'plane',
  arrive: 'plane-arrive',
  depart: 'plane-depart',
  train: 'train',
  bus: 'bus',
  car: 'car',
  boat: 'boat',
  walk: 'walk',
};

const labels: Record<string, string> = {
  plane: 'Flight',
  arrive: 'Arrival',
  depart: 'Departure',
  train: 'Train',
  bus: 'Bus',
  car: 'Drive',
  boat: 'Boat',
  walk: 'On foot',
};

const icon = mode ? (icons[mode] ?? 'car') : 'pin';
/* A day can have a route and no transit to quote — Sept 18 is a led walk
   downtown. It still gets the block; it just has nothing to put on the clock. */
const label = mode ? (labels[mode] ?? 'Travel') : 'Today’s route';

const hasRoute = stops.length > 0;
const spoken = [label, duration].filter(Boolean).join(', ');
---

<aside class="travel" aria-label={`Travel today: ${spoken}`}>
  <div class="travel__head">
    <span class="travel__icon"><Icon name={icon} size={24} /></span>
    <p class="travel__label">{label}</p>
    {duration && <p class="travel__duration">{duration}</p>}
  </div>

  {hasRoute && <div class="travel__route"><JourneyStrip stops={stops} onInk /></div>}

  {/* Only where there's no route to draw — otherwise it says it twice. */}
  {!hasRoute && detail && <p class="travel__detail">{detail}</p>}

  {
    notes.length > 0 && (
      <ul class="travel__notes">
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    )
  }
</aside>

<style>
  .travel {
    background: var(--ink);
    color: var(--cream);
    padding: 15px 17px 17px;
    border-left: 5px solid var(--gold);
  }

  /* Mode on the left, clock on the right, hairline under both. */
  .travel__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--cream-28);
  }

  .travel__icon {
    display: flex;
    color: var(--gold);
  }

  .travel__label {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .travel__duration {
    margin: 0;
    font-family: var(--display);
    font-size: 24px;
    line-height: 1;
    text-transform: uppercase;
    text-align: right;
  }

  .travel__route {
    padding-top: 14px;
  }

  .travel__detail {
    margin: 13px 0 0;
    font-size: var(--fs-note);
    line-height: 1.45;
    color: rgba(255, 251, 245, 0.82);
  }

  .travel__notes {
    display: grid;
    gap: 3px;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--cream-25);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--cream-55);
  }
  .travel__notes li {
    display: flex;
    gap: 8px;
  }
  .travel__notes li::before {
    content: '·';
    color: var(--gold);
    font-weight: 700;
  }

  @media print {
    .travel {
      background: #fff;
      color: #000;
      border: 1px solid #999;
      border-left: 4px solid #000;
    }
    .travel__label,
    .travel__icon {
      color: #000;
    }
    .travel__head {
      border-bottom-color: #999;
    }
    .travel__detail,
    .travel__notes {
      color: #333;
    }
    .travel__notes {
      border-top-color: #999;
    }
  }
</style>
