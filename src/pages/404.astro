---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Peru Field Guide" description="That page isn't part of the Peru field guide.">
  <div class="page">
    <div class="shell">
      <div class="nf">
        <p class="nf__num" aria-hidden="true">404</p>
        <h1 class="nf__title">Off the map</h1>
        <p class="nf__text">
          That page isn't part of the guide. Everything — the eleven days, the little black book, the packing list — lives
          on one page.
        </p>
        <a class="nf__link" href="/">Back to the guide</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .nf {
    background: var(--pink);
    color: var(--cream);
    padding: 44px var(--pad) 40px;
    min-height: 100vh;
  }

  .nf__num {
    margin: 0;
    font-family: var(--display);
    font-size: var(--fs-hero);
    line-height: 0.86;
    color: transparent;
    -webkit-text-stroke: 2px var(--gold);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .nf__num {
      color: var(--gold);
    }
  }

  .nf__title {
    margin: 14px 0 0;
    font-family: var(--display);
    font-size: var(--fs-section);
    line-height: 1;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--ink);
  }

  .nf__text {
    margin: 14px 0 0;
    max-width: 36ch;
    font-size: var(--fs-note);
    line-height: 1.5;
  }

  .nf__link {
    display: inline-block;
    margin-top: 22px;
    padding: 11px 14px;
    background: var(--ink);
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nf__link:hover {
    background: var(--gold);
    color: var(--ink);
  }
</style>
