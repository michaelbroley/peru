---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import MegaNav from '../components/MegaNav.astro';
import SectionFold from '../components/SectionFold.astro';
import SnapshotTable from '../components/SnapshotTable.astro';
import ReservationCard from '../components/ReservationCard.astro';
import WeatherCard from '../components/WeatherCard.astro';
import DayCard from '../components/DayCard.astro';
import PlaceCard from '../components/PlaceCard.astro';
import PackingList from '../components/PackingList.astro';
import MapPanel from '../components/MapPanel.astro';
import MapLoader from '../components/MapLoader.astro';
import MapSprite from '../components/MapSprite.astro';
import TodayPanel from '../components/TodayPanel.astro';
import TodayLoader from '../components/TodayLoader.astro';
import { STAR } from '../lib/glyphs';
import { Image } from 'astro:assets';
import { covers } from '../lib/covers';
import Icon, { type IconName } from '../components/Icon.astro';
import RegionBar from '../components/RegionBar.astro';
import Llama from '../components/Llama.astro';
import PhraseList from '../components/PhraseList.astro';
import Habitat from '../components/Habitat.astro';

const tripEntry = await getEntry('trip', 'snapshot');
if (!tripEntry) throw new Error('Missing trip snapshot content');
const trip = tripEntry.data;

const days = (await getCollection('days')).sort((a, b) => a.data.order - b.data.order);
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const weatherRows = (await getCollection('weatherRows')).sort((a, b) => a.data.order - b.data.order);
const packing = (await getCollection('packing')).sort((a, b) => a.data.order - b.data.order);
const phrases = (await getCollection('phrases')).sort((a, b) => a.data.order - b.data.order);
const spanish = phrases.filter((p) => p.data.book === 'spanish').map((p) => p.data);
const quechua = phrases.filter((p) => p.data.book === 'quechua').map((p) => p.data);
const aymara = phrases.filter((p) => p.data.book === 'aymara').map((p) => p.data);
const maps = await getCollection('maps');
const routeMap = maps.find((m) => m.id === 'peru');

const placeData = places.map((p) => p.data);

// Shared by every day's locator: the route to draw, and the trip's high point.
const route = days.map((d) => ({ lat: d.data.point.lat, lng: d.data.point.lng }));
const peak = days.reduce((max, d) => Math.max(max, d.data.elevation.metres), 0);

// Anchors mirror the Quick Links TOC in Peru_Trip_Content.md.
const sections = [
  { num: '01', href: '#trip-snapshot', label: 'Trip snapshot' },
  { num: '02', href: '#weather-september-50-year-averages', label: 'Weather' },
  { num: '03', href: '#day-by-day', label: 'Day by day' },
  { num: '04', href: '#recommendations-little-black-book-for-laura', label: 'Recommendations' },
  {
    num: '05',
    href: '#packing-tuned-to-this-trip-sea-level-to-3800-m-cold-nights-rustic-homestay-early-machu-picchu',
    label: 'Packing',
  },
  { num: '06', href: '#common-spanish-phrases', label: 'Spanish phrases' },
  { num: '07', href: '#key-quechua-phrases-for-the-homestay', label: 'Quechua phrases' },
  { num: '08', href: '#key-aymara-phrases-just-in-case', label: 'Aymara phrases' },
];

const dayLinks = days.map((d) => ({
  href: `#${d.data.slug}`,
  meta: d.data.date,
  label: d.data.title,
}));

/**
 * The little black book is thirteen lists in a row, which reads as one long
 * wall of type. Grouping them into chapters — each with a photograph and its
 * counts — gives it landmarks to scroll between and somewhere to aim for.
 *
 * The order is the content's own; these only say where the breaks fall.
 */
const RECOMMENDATION_CHAPTERS = [
  { title: 'Lima', regions: ['Lima'], cover: 'lima-cathedral' },
  { title: 'Across Peru', regions: ['Peru'], cover: 'alpaca' },
  {
    title: 'Cusco & the Sacred Valley',
    regions: ['Cusco', 'Sacred Valley', 'Aguas Calientes'],
    cover: 'terraces',
  },
  { title: 'Puno & Lake Titicaca', regions: ['Puno'], cover: 'uros-boat' },
] as const;

const chapters = RECOMMENDATION_CHAPTERS.map((chapter) => {
  const lists = categories.filter((c) => (chapter.regions as readonly string[]).includes(c.data.region));
  const count = lists.reduce((n, c) => n + placeData.filter((p) => p.category === c.id).length, 0);
  return { title: chapter.title, cover: chapter.cover, lists, count };
});

// A region nobody claimed would otherwise vanish off the page — put it at the
// end rather than lose it.
const claimed = new Set(chapters.flatMap((c) => c.lists.map((l) => l.id)));
const orphans = categories.filter((c) => !claimed.has(c.id));
if (orphans.length > 0) {
  chapters.push({
    title: 'Elsewhere',
    cover: undefined as unknown as (typeof RECOMMENDATION_CHAPTERS)[number]['cover'],
    lists: orphans,
    count: orphans.reduce((n, c) => n + placeData.filter((p) => p.category === c.id).length, 0),
  });
}

const categoryLinks = chapters.flatMap((chapter) =>
  chapter.lists.map((c, i) => ({
    href: `#${c.data.slug}`,
    // The chapter heading already says "Lima"; the row doesn't need to.
    label: c.data.title.startsWith(`${chapter.title} — `)
      ? c.data.title.slice(chapter.title.length + 3)
      : c.data.title,
    group: i === 0 ? chapter.title : undefined,
  })),
);

const highestAltitude = trip.altitude.profile.reduce((max, p) => Math.max(max, p.metres), 0);

const title = 'Peru Field Guide — Michael & Laura, Sept 2026';
const description =
  'Eleven days in Peru, Sept 16–26 2026: day-by-day plan, weather, the little black book of places to eat, drink and see, packing and what still needs booking.';
---

<Base title={title} description={description}>
  <div class="page">
    <div class="shell">
      <!-- ── Masthead ─────────────────────────────────────────────────── -->
      <header class="hero">
        {/* The masthead is still the comp's pink block — the photograph sits
            under a heavy pink wash so it reads as texture, not as a hero
            image competing with the wordmark. */}
        <div class="hero__bg" aria-hidden="true">
          <Image
            class="hero__img"
            src={covers.alpaca.src}
            alt=""
            widths={[600, 900, 1400, 1900]}
            sizes="(min-width: 1440px) 1320px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="auto"
            {/* It sits under a 70–97% pink wash, so detail here is invisible
                and full quality would just be weight on the first paint. */}
            quality={45}
            style={`object-position:${covers.alpaca.focus}`}
          />
          <span class="hero__wash"></span>
        </div>

        <p class="hero__dates">{trip.onTheGround}</p>
        <h1 class="hero__title">Peru</h1>
        <p class="hero__names">{trip.travellers}</p>

        <TodayPanel days={days} />

        <dl class="hero__stats">
          {
            trip.stats.map((stat) => (
              <div class="hero__stat">
                <dt class="sr-only">{stat.label}</dt>
                <dd class="hero__statvalue">{stat.value}</dd>
                <p class="hero__statlabel" aria-hidden="true">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </dl>
      </header>

      <MegaNav sections={sections} days={dayLinks} categories={categoryLinks} />

      <main id="main">
        <!-- ── 01 Trip snapshot ───────────────────────────────────────── -->
        <section class="section" id="trip-snapshot" data-section aria-labelledby="trip-snapshot-title">
          <h2 class="sr-only" id="trip-snapshot-title">Trip snapshot</h2>
          <SectionFold num="01" title="Trip snapshot" cover="lima-coast" eager fold="trip-snapshot">
          <div class="stack">
            <SnapshotTable rows={[...trip.flights, ...trip.snapshot]} />

            <section class="booked" aria-labelledby="booked-title">
              <h3 class="booked__label" id="booked-title">
                <Icon name="ticket" size={16} />
                Booked reservations
              </h3>
              <div class="booked__grid">
                {trip.reservations.map((res) => <ReservationCard {...res} />)}
              </div>
            </section>

            <div class="altitude on-ink">
              <p class="altitude__label">
                <span class="altitude__dot" aria-hidden="true"></span>
                Altitude
              </p>
              <p class="altitude__text" set:html={trip.altitude.text} />

              <div class="altitude__chart" role="img" aria-label="Altitude profile: sea level in Lima, 3,450 m in Cusco, 3,800 m at Lake Titicaca, back to sea level">
                {
                  trip.altitude.profile.map((point) => (
                    <span
                      class={`altitude__bar altitude__bar--${point.tone}`}
                      style={`height:${Math.max(6, Math.round((point.metres / highestAltitude) * 100))}%`}
                      title={`${point.day}: ${point.metres.toLocaleString('en-CA')} m`}
                    />
                  ))
                }
              </div>
              <div class="altitude__axis">
                {trip.altitude.axis.map((tick) => <span>{tick}</span>)}
              </div>
            </div>

            {routeMap && <MapPanel view={routeMap.data} id="route" label="Route map" />}
          </div>
          </SectionFold>
        </section>

        <!-- ── 02 Weather ─────────────────────────────────────────────── -->
        <section
          class="section"
          id="weather-september-50-year-averages"
          data-section
          aria-labelledby="weather-title"
        >
          <h2 class="sr-only" id="weather-title">Weather</h2>
          <SectionFold
            num="02"
            title="Weather"
            cover="rainbow-mountain"
            fold="weather-september-50-year-averages"
            lead="September, ~50-year averages. Dry-season conditions, thinner crowds. Plan for the day/night swing more than rain — strong high-altitude sun burns even when cool, so sunscreen daily."
          >
            <div class="weather-grid">
              {weatherRows.map((row) => <WeatherCard row={row.data} />)}
            </div>
          </SectionFold>
        </section>

        <!-- ── 03 Day by day ──────────────────────────────────────────── -->
        <section class="section" id="day-by-day" data-section aria-labelledby="days-title">
          <h2 class="sr-only" id="days-title">Day by day</h2>
          <SectionFold
            num="03"
            title="Day by day"
            cover="machu-picchu"
            fold="day-by-day"
            lead="Each day shows where the plan puts us, how high up that is, and what the weather is doing — today's reading is live, the rest are September averages. It's the itinerary, not a GPS tracker."
          >
          <div class="day-controls">
            <button class="btn btn--solid" type="button" data-days-expand>Expand all</button>
            <button class="btn" type="button" data-days-collapse>Collapse all</button>
          </div>

          <div class="days" data-days>
            {
              days.map((day, i) => (
                <DayCard
                  day={day.data}
                  categories={categories}
                  places={placeData}
                  maps={maps}
                  route={route}
                  peak={peak}
                  open={i === 0}
                  last={i === days.length - 1}
                />
              ))
            }
          </div>
          </SectionFold>
        </section>

        <!-- ── 04 Recommendations ─────────────────────────────────────── -->
        <section
          class="section"
          id="recommendations-little-black-book-for-laura"
          data-section
          aria-labelledby="recs-title"
        >
          <h2 class="sr-only" id="recs-title">Recommendations — Little Black Book</h2>
          <SectionFold
            num="04"
            title="Recommendations"
            cover="dancers"
            fold="recommendations-little-black-book-for-laura"
            lead={`The little black book, for Laura. Every entry: name — area — note, with address and phone where known. ${STAR} = top pick.`}
          >
          {
            chapters.map((chapter) => (
              <div class="chapter">
                <RegionBar
                  title={chapter.title}
                  meta={`${chapter.lists.length} list${chapter.lists.length === 1 ? '' : 's'} · ${chapter.count} places`}
                  cover={chapter.cover}
                  compact
                />

                <div class="cats">
                  {chapter.lists.map((category) => {
                    const catPlaces = placeData.filter((p) => p.category === category.id);
                    const picks = catPlaces.filter((p) => p.pick).length;
                    const emptyWhen = (['food', 'skate'] as const)
                      .filter((lens) => !catPlaces.some((p) => p.lens === lens))
                      .join(' ');
                    return (
                      <section class="cat" id={category.data.slug} data-lens-empty-when={emptyWhen || undefined}>
                        <h4 class="cat__title">
                          {category.data.icon && (
                            <Icon name={category.data.icon as IconName} size={20} class="cat__icon" />
                          )}
                          <span class="cat__titletext">{category.data.title}</span>
                          <span class="cat__count">
                            <span>{catPlaces.length}</span>
                            {picks > 0 && <span class="cat__countpick">{`${STAR}${picks}`}</span>}
                          </span>
                        </h4>
                        {category.data.aside && <p class="cat__aside">{category.data.aside}</p>}
                        <div class="cat__grid">
                          {catPlaces.map((place) => (
                            <PlaceCard {...place} level={5} />
                          ))}
                        </div>
                      </section>
                    );
                  })}
                </div>
              </div>
            ))
          }
          </SectionFold>
        </section>

        <!-- ── 05 Packing ─────────────────────────────────────────────── -->
        <section
          class="section"
          id="packing-tuned-to-this-trip-sea-level-to-3800-m-cold-nights-rustic-homestay-early-machu-picchu"
          data-section
          aria-labelledby="packing-title"
        >
          <h2 class="sr-only" id="packing-title">Packing</h2>
          <SectionFold
            num="05"
            title="Packing"
            cover="trekker"
            fold="packing-tuned-to-this-trip-sea-level-to-3800-m-cold-nights-rustic-homestay-early-machu-picchu"
            lead="Tuned to this trip: sea level to 3,800 m, cold nights, rustic homestay, early Machu Picchu."
          >
            <PackingList groups={packing.map((p) => p.data)} />
          </SectionFold>
        </section>

        <!-- ── 06 Common Spanish phrases ──────────────────────────────── -->
        <section class="section" id="common-spanish-phrases" data-section aria-labelledby="spanish-title">
          <h2 class="sr-only" id="spanish-title">Common Spanish phrases</h2>
          <SectionFold
            num="06"
            title="Spanish phrases"
            cover="parque-del-amor"
            fold="common-spanish-phrases"
            lead="Peruvians are warm and appreciate any effort; even a few words go a long way. Spanish is used everywhere on this trip."
          >
            <PhraseList groups={spanish} />
          </SectionFold>
        </section>

        <!-- ── 07 Key Quechua phrases ─────────────────────────────────── -->
        <section class="section" id="key-quechua-phrases-for-the-homestay" data-section aria-labelledby="quechua-title">
          <h2 class="sr-only" id="quechua-title">Key Quechua phrases, for the homestay</h2>
          <SectionFold
            num="07"
            title="Quechua phrases"
            cover="uros"
            fold="key-quechua-phrases-for-the-homestay"
            lead="Around Lake Titicaca, many families speak Quechua first and Spanish second. A handful of words is a genuine sign of respect and always gets a smile."
          >
            <p class="phrasenote">
              <span class="phrasenote__mark" aria-hidden="true">!</span>
              <span>
                Some communities on the lake speak Aymara rather than Quechua — listen to how your host family
                greets you and follow their lead. <a href="#key-aymara-phrases-just-in-case">Aymara is next</a>.
              </span>
            </p>

            <PhraseList groups={quechua} />

            <p class="phrasetip">
              <span class="phrasetip__label">Tip</span>
              A small gift for the host family (fresh fruit from Puno market, school supplies) paired with a
              “Sulpayki” goes a long way.
            </p>
          </SectionFold>
        </section>

        <!-- ── 08 Key Aymara phrases ──────────────────────────────────── -->
        <section
          class="section"
          id="key-aymara-phrases-just-in-case"
          data-section
          aria-labelledby="aymara-title"
        >
          <h2 class="sr-only" id="aymara-title">Key Aymara phrases, just in case</h2>
          <SectionFold
            num="08"
            title="Aymara phrases"
            cover="titicaca-puno"
            fold="key-aymara-phrases-just-in-case"
            lead="Some Lake Titicaca communities speak Aymara rather than Quechua — especially around the lake toward the Bolivian side. If your host family greets you in Aymara, these will earn a big smile."
          >
            <PhraseList groups={aymara} />

            <p class="phrasetip">
              <span class="phrasetip__label">Tip</span>
              When in doubt, “Kamisaraki” (hello) and “Yuspagara” (thank you) are the two to remember — pair
              them with a small gift for the host family and you're golden.
            </p>
          </SectionFold>
        </section>
      </main>

      <Habitat />

      {/* Inline and in the body on purpose: it runs while the parser is still
          here, so a section you left shut is never painted open first. */}
      <script is:inline>
        try {
          var shut = JSON.parse(localStorage.getItem('peru-folded-sections') || '[]');
          if (Array.isArray(shut)) {
            for (var i = 0; i < shut.length; i++) {
              var el = document.querySelector('[data-section-fold="' + shut[i] + '"]');
              if (el) el.open = false;
            }
          }
        } catch (e) {
          /* No storage, or nothing stored — every section stays open. */
        }
      </script>
    </div>
  </div>

  <MapSprite />
  <MapLoader />
  <TodayLoader />
  <Llama />

  <script>
    // Expand / collapse all — the only other interactive bit on the page.
    // Scoped to [data-day] so it never touches the <details> a map uses for
    // its list of pins.
    const days = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-days] details[data-day]'));
    document
      .querySelector('[data-days-expand]')
      ?.addEventListener('click', () => days().forEach((d) => (d.open = true)));
    document
      .querySelector('[data-days-collapse]')
      ?.addEventListener('click', () => days().forEach((d) => (d.open = false)));
  </script>
</Base>

<style>
  /* ── Masthead ──────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--pink);
    color: var(--cream);
    padding: 34px var(--pad) 26px;
    overflow: hidden;
  }

  /* Behind everything, including on a first offline load where the image
     never arrives and the flat pink simply stays. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Pulled back so it sits under the pink rather than fighting it. */
    filter: saturate(0.7) contrast(1.02);
  }

  /* Densest where the type sits, thinnest at the top right, so the alpaca
     stays readable without costing any contrast. */
  .hero__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(228, 0, 124, 0.72) 0%,
      rgba(228, 0, 124, 0.84) 34%,
      rgba(228, 0, 124, 0.93) 68%,
      rgba(228, 0, 124, 0.97) 100%
    );
  }

  @media (min-width: 860px) {
    /* Side by side, the clear corner moves to the right of the wordmark. */
    .hero__wash {
      background: linear-gradient(
        105deg,
        rgba(228, 0, 124, 0.96) 0%,
        rgba(228, 0, 124, 0.93) 40%,
        rgba(228, 0, 124, 0.8) 72%,
        rgba(228, 0, 124, 0.7) 100%
      );
    }
  }

  .hero__dates {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-label);
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .hero__title {
    margin: 14px 0 0;
    font-family: var(--display);
    font-size: var(--fs-hero);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .hero__names {
    margin: 10px 0 0;
    font-family: var(--display);
    font-size: var(--fs-name);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 22px 0 0;
    background: var(--cream-30);
    border: 1px solid var(--cream-30);
  }

  /* Masthead: the wordmark grows with the card, and on a wide screen the
     blurb and the stats sit beside it instead of stacking. */
  @media (min-width: 860px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 40px;
      align-items: end;
      padding-top: 48px;
      padding-bottom: 40px;
    }
    .hero__dates,
    .hero__title,
    .hero__names {
      grid-column: 1;
    }
    .hero > :global(.today) {
      grid-column: 2;
      grid-row: 1 / 4;
      align-self: center;
      margin-top: 0;
    }
    .hero__stats {
      grid-column: 1 / -1;
      margin-top: 30px;
    }
    .hero__title {
      font-size: clamp(74px, 11vw, 132px);
    }
    .hero__names {
      font-size: clamp(25px, 3vw, 34px);
    }
  }

  @media (min-width: 1080px) {
    .hero__stats {
      max-width: 560px;
    }
  }

  .hero__stat {
    background: var(--pink);
    padding: 11px 10px;
  }

  .hero__statvalue {
    margin: 0;
    font-family: var(--display);
    font-size: var(--fs-stat);
    line-height: 0.85;
    color: var(--gold);
  }

  .hero__statlabel {
    margin: 6px 0 0;
    font-weight: 700;
    font-size: var(--fs-label-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ── Sections ──────────────────────────────────────────────────────── */
  /* Only when it's open: shut, the first band should meet the nav directly. */
  .section:first-of-type:has([data-section-fold][open]) {
    padding-top: 30px;
  }
  .stack {
    display: grid;
    gap: 18px;
    margin-top: 18px;
  }

  @media (min-width: 860px) {
    .stack {
      gap: 22px;
    }
  }

  /* ── Altitude profile ──────────────────────────────────────────────── */
  .altitude {
    background: var(--ink);
    color: var(--cream);
    padding: 16px 16px 17px;
  }

  .altitude__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-label);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .altitude__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
  }

  .altitude__text {
    margin: 9px 0 0;
    font-size: var(--fs-body);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .altitude__chart {
    display: flex;
    gap: 2px;
    margin-top: 14px;
    align-items: flex-end;
    height: 44px;
  }

  .altitude__bar {
    flex: 1;
    background: var(--cream-25);
  }
  .altitude__bar--mid {
    background: var(--pink);
  }
  .altitude__bar--high {
    background: var(--gold);
  }

  .altitude__axis {
    display: flex;
    justify-content: space-between;
